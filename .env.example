# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/koskita

# Redis (Upstash)
REDIS_URL=https://your-redis.upstash.io
REDIS_TOKEN=your-redis-token

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your-secret-key-min-32-chars

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Payment Gateways
XENDIT_SECRET_KEY=xnd_development_your_key
MIDTRANS_SERVER_KEY=SB-Mid-server-your_key

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key

# Object Storage (S3/R2)
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=koskita-uploads

# Cron Security
CRON_SECRET=your-cron-secret-key

# Encryption (for gateway credential encryption, AES-256-GCM)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key
