# =============================================================================
# KosKita — Environment Variables
# Copy this file to .env and fill in the values.
# For local development with Docker Compose, the defaults below work out of the box.
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
# Docker Compose default: postgresql://postgres:postgres@localhost:5432/koskita
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/koskita

# --- Redis -------------------------------------------------------------------
# For local dev with Docker Compose, use direct Redis URL:
REDIS_URL=redis://localhost:6379
# For production (Upstash), use these instead:
# REDIS_URL=https://your-redis.upstash.io
# REDIS_TOKEN=your-redis-token

# --- Authentication (Better Auth) --------------------------------------------
BETTER_AUTH_SECRET=your-secret-key-min-32-chars

# --- Google OAuth -------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Payment Gateways --------------------------------------------------------
XENDIT_SECRET_KEY=xnd_development_your_key
MIDTRANS_SERVER_KEY=SB-Mid-server-your_key

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key

# --- WhatsApp (Fonnte) -------------------------------------------------------
FONNTE_API_TOKEN=your-fonnte-token

# --- Object Storage (S3/R2) --------------------------------------------------
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=koskita-uploads

# --- Cron Security ------------------------------------------------------------
CRON_SECRET=your-cron-secret-key

# --- Encryption (AES-256-GCM for gateway credentials) ------------------------
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# --- Error Tracking (Sentry) -------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# --- App Config ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
USE_REAL_DB=false
